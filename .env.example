# Browser-facing API URL. Required for the upload UI; local and preview only.
NEXT_PUBLIC_API_URL=http://127.0.0.1:4100

# Fastify API origin allowed by CORS. Optional locally; restrict to the web origin in production.
WEB_ORIGIN=http://localhost:3000
PORT=4100

# Persistent job metadata. Required for the shared API/worker runtime.
# Use a PostgreSQL database with infrastructure/postgres/001_processing_jobs.sql applied.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# BullMQ queue connection. Required by both the API and worker.
REDIS_URL=redis://HOST:6379

# Private S3-compatible object storage. Required for the persistent runtime and /ready.
# For local development this can point to MinIO; for production use a private bucket.
S3_ENDPOINT=http://HOST:9000
S3_REGION=us-east-1
S3_BUCKET=cutoutbg-private
S3_ACCESS_KEY=replace-with-storage-access-key
S3_SECRET_KEY=replace-with-storage-secret-key

# Local filesystem fallback paths. Used only when S3 credentials are absent.
UPLOAD_DIR=./.data/uploads
RESULT_DIR=./.data/results

# Upload and processing limits. Defaults are shown explicitly for deployment review.
MAX_BYTES=26214400
MAX_PIXELS=40000000
MAX_WIDTH=12000
MAX_HEIGHT=12000
INFERENCE_TIMEOUT_MS=120000

# Worker inference settings.
PYTHON=python
PYTHONPATH=src
MODEL_CACHE_DIR=./model-cache
INFERENCE_DEVICE=cpu
